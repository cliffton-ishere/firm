# Both variables are optional. The app runs with neither set.

# Production RPC for Robinhood Chain. Defaults to the public endpoint,
# which is fine for light reads but rate-limited.
# NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WalletConnect Cloud project id. When absent, the WalletConnect option is
# omitted from the wallet sheet entirely rather than shown as a dead entry.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
